{
  "id": "redis",
  "name": "Redis",
  "api": "redis",
  "protocol_version": "1.0",
  "version": "0.1.0",
  "entry": { "command": "./onetcli-redis-driver" },
  "transport": { "name": "redis.sock" },
  "methods": [
    "conn/open",
    "conn/close",
    "redis/command",
    "redis/pipeline",
    "redis/pubsub_open",
    "redis/pubsub_control",
    "event/read",
    "event/close",
    "blob/open",
    "blob/read",
    "blob/close"
  ],
  "compatibility": {
    "modes": ["standalone"],
    "server": { "min": "5.0" }
  },
  "process": { "scope": "connection", "kill_on_drop": true }
}
