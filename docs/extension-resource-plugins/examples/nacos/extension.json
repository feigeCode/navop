{
  "schema_version": 1,
  "id": "com.navop.nacos",
  "name": "Navop Nacos Resource Provider",
  "version": "0.1.0",
  "description": "Reference IPC provider for Nacos namespaces, configuration and services.",
  "engines": {
    "onetcli": ">=0.1.0"
  },
  "permissions": [
    "net:tcp:nacos.example.com:8848",
    "secrets:read:self.*",
    "spawn:./bin/nacos-provider"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/nacos-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        }
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "nacos",
        "label": "Nacos",
        "runtimeId": "main",
        "resourceType": "nacos",
        "form": { "tabs": [{ "id": "general", "label": "General", "fields": [
          { "id": "server", "label": "Server", "fieldType": "Text", "required": true }
        ] }] }
      }
    ]
  }
}
