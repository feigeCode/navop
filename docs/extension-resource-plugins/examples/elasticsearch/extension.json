{
  "schema_version": 1,
  "id": "com.navop.elasticsearch",
  "name": "Navop Elasticsearch Resource Provider",
  "version": "0.1.0",
  "description": "Reference IPC provider for Elasticsearch indices, mappings, search and documents.",
  "engines": {
    "onetcli": ">=0.15.1",
    "nsh": "0.3.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "shell:exec",
    "net:tcp:elasticsearch.example.com:9200",
    "secrets:read:self.*",
    "spawn:./bin/elasticsearch-provider"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/elasticsearch-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        }
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "elasticsearch",
        "label": "Elasticsearch",
        "runtimeId": "main",
        "resourceType": "elasticsearch",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "General",
              "fields": [
                {
                  "id": "url",
                  "label": "URL",
                  "fieldType": "Text",
                  "required": true
                }
              ]
            }
          ]
        },
        "route": "explorer"
      }
    ],
    "shellApp": {
      "title": "Open Elasticsearch Explorer",
      "entry": "ui/explorer.js",
      "category": "database",
      "keywords": [
        "elasticsearch",
        "search"
      ],
      "backends": {
        "search": "main"
      },
      "modules": [
        "resource"
      ]
    }
  }
}
