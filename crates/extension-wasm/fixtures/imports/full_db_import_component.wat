(component
    (type $ui-instance
        (instance
            (type (;0;) (record (field "id" string) (field "value" string)))
            (export (;1;) "field-value" (type (eq 0)))
            (type (;2;) (list 1))
            (type (;3;) (record (field "view-id" string) (field "action-id" string) (field "fields" 2)))
            (export (;4;) "view-action-event" (type (eq 3)))
        )
    )
    (import "onet:extension/ui" (instance $ui (type $ui-instance)))
    (alias export $ui "view-action-event" (type $view-action-event))
    (type $handle-view-action-ty (func (param "event" $view-action-event)))
    (type $db-instance
        (instance
            (type (;0;) (option string))
            (type (;1;) (record (field "id" string) (field "name" string) (field "driver" string) (field "database" 0)))
            (export (;2;) "connection-info" (type (eq 1)))
            (type (;3;) (list 2))
            (type (;4;) (option u32))
            (type (;5;) (option u64))
            (type (;6;) (record (field "max-rows" 4) (field "timeout-ms" 5) (field "streaming" bool)))
            (export (;7;) "exec-options" (type (eq 6)))
            (type (;8;) (record (field "name" string) (field "type-name" string) (field "nullable" bool)))
            (export (;9;) "column" (type (eq 8)))
            (type (;10;) (list u8))
            (type (;11;) (variant (case "null") (case "boolean" bool) (case "integer" s64) (case "float" f64) (case "text" string) (case "bytes" 10)))
            (export (;12;) "db-value" (type (eq 11)))
            (type (;13;) (list 9))
            (type (;14;) (list 12))
            (type (;15;) (list 14))
            (type (;16;) (record (field "columns" 13) (field "rows" 15) (field "next-cursor" 0)))
            (export (;17;) "row-batch" (type (eq 16)))
            (type (;18;) (record (field "code" string) (field "message" string)))
            (export (;19;) "db-error" (type (eq 18)))
            (export (;20;) "session" (type (sub resource)))
            (type (;21;) (borrow 20))
            (type (;22;) (own 20))
            (type (;23;) (result 17 (error 19)))
            (type (;24;) (func (param "self" 21) (param "sql" string) (param "options" 7) (result 23)))
            (export (;0;) "[method]session.execute" (func (type 24)))
            (type (;25;) (list string))
            (type (;26;) (result 25 (error 19)))
            (type (;27;) (func (param "self" 21) (result 26)))
            (export (;1;) "[method]session.list-databases" (func (type 27)))
            (type (;28;) (func (param "self" 21) (param "database" string) (result 26)))
            (export (;2;) "[method]session.list-schemas" (func (type 28)))
            (type (;29;) (result (error 19)))
            (type (;30;) (func (param "self" 21) (result 29)))
            (export (;3;) "[method]session.close" (func (type 30)))
            (export (;31;) "cursor" (type (sub resource)))
            (type (;32;) (borrow 31))
            (type (;33;) (func (param "self" 32) (result 29)))
            (export (;4;) "[method]cursor.close" (func (type 33)))
            (type (;34;) (result 3 (error 19)))
            (type (;35;) (func (result 34)))
            (export (;5;) "list-connections" (func (type 35)))
            (type (;36;) (result 22 (error 19)))
            (type (;37;) (func (param "connection-id" string) (param "database" 0) (result 36)))
            (export (;6;) "open-session" (func (type 37)))
        )
    )
    (import "onet:extension/db" (instance $db (type $db-instance)))
    (core module $m
        (memory (export "memory") 1)
        (func (export "realloc") (param i32 i32 i32 i32) (result i32)
            i32.const 2048
        )
        (func (export "activate"))
        (func (export "run-action"))
        (func (export "handle-view-action") (param i32 i32 i32 i32 i32 i32))
        (func (export "deactivate"))
    )
    (core instance $i (instantiate $m))
    (alias core export $i "memory" (core memory $memory))
    (alias core export $i "realloc" (core func $realloc))
    (func $activate (canon lift (core func $i "activate")))
    (func $run-action (canon lift (core func $i "run-action")))
    (func $handle-view-action (type $handle-view-action-ty)
        (canon lift
            (core func $i "handle-view-action")
            (memory $memory)
            (realloc $realloc)
            string-encoding=utf8
        ))
    (func $deactivate (canon lift (core func $i "deactivate")))
    (export "activate" (func $activate))
    (export "run-action" (func $run-action))
    (export "handle-view-action" (func $handle-view-action) (func (type $handle-view-action-ty)))
    (export "deactivate" (func $deactivate))
)
